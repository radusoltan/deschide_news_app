# ==============================================================================
# Deschide News App Monorepo - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.fleet/

# ------------------------------------------------------------------------------
# Operating Systems
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Environment & Secrets (Monorepo Level)
# ------------------------------------------------------------------------------
.env
.env.local
.env*.local
.env.backup
.env.backup.*
*.pem
*.key
*.crt
**/NEW_CREDENTIALS.txt
**/import-sources-credentials.txt
*.backup

# ------------------------------------------------------------------------------
# Testing & QA Artifacts (CRITICAL)
# ------------------------------------------------------------------------------
.playwright-mcp/
**/screenshots/
**/test-results/
**/.playwright/
coverage/
.nyc_output/
**/__snapshots__/
*.spec.js.snap
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# UI/UX Layout References (CRITICAL - 230MB)
# ------------------------------------------------------------------------------
layouts/
# Note: Reference templates only - see docs/guides/ui-templates.md for sources

# ------------------------------------------------------------------------------
# Context & Implementation Notes (Temporary)
# ------------------------------------------------------------------------------
context/
.context/
*.context.md
notes/
scratch/
TODO.local.md

# ------------------------------------------------------------------------------
# Build Artifacts (Monorepo Level)
# ------------------------------------------------------------------------------
/node_modules/
/dist/
/build/
/out/

# ------------------------------------------------------------------------------
# Package Manager Locks (Monorepo)
# ------------------------------------------------------------------------------
# Note: Apps have their own lock files
/pnpm-lock.yaml
/package-lock.json
/yarn.lock

# ------------------------------------------------------------------------------
# Archives & Backups
# ------------------------------------------------------------------------------
*.backup
*_OLD/
archive_old/
*.tar.gz
*.zip
*.rar

# Note: archive/ contains historical migration docs - KEEP COMMITTED

# PostgreSQL backups (database dumps)
backups/
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# AI/LLM Development Tools
# ------------------------------------------------------------------------------
.cursor/
.claude-cache/
# .mcp.json - INCLUDED: Standard dev tool for Playwright testing

# ------------------------------------------------------------------------------
# Database Files (Development)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# Repo-cleanup pass (pre-FRA1) — 2026-04-30
# ------------------------------------------------------------------------------

# Stray Obsidian artifacts (canonical vault is OUTSIDE repo)
.obsidian/
deschide/
vault/

# Top-level orphan log dir (canonical: apps/backend/var/)
/var/

# Ad-hoc data exports
articles-export-*.csv
*-export-*.csv
*.csv:Zone.Identifier

# Local-only scratch at repo root
/Wiki_models_report.txt
/from_prod.txt
/urls_status.txt
/fb_promts.txt
/skills-lock.json
/Screenshot_*.png
/Screenshot_*.jpg

# CC-generated reports at root
/T??-*.md
/S??-*.md
/sprint-*-*.md

# Test session screenshots in app roots
apps/frontend/*.png
apps/frontend/*.jpg
apps/backend/*.png

# PHPStan ad-hoc output
apps/backend/phpstan_analysis.json
apps/backend/phpstan_analysis.txt

# Pytest cache
tools/python-scraper/.pytest_cache/
tools/python-scraper/**/__pycache__/

# Claude Code transient state
.claude/inbox.md
.claude/scheduled_tasks.lock
.claude/agents/skills/news-scrapper/

# Accidental nested clones
apps/frontend/apps/
.envrc
