# =============================================================================
# STAGING ENVIRONMENT — non-secret defaults (COMMITTED)
# =============================================================================
#
# Next.js does NOT auto-load .env.staging (unlike Symfony Dotenv).
# Loading is performed explicitly by the staging supervisor command via:
#
#   bash -c 'set -a; source .env.staging; source .env.staging.local; set +a; \
#            exec node_modules/.bin/next start -p 3001'
#
# See ADR-023 D7 + apps/backend/config/supervisor/staging/nextjs-staging.conf
# (authored in T57.02b Phase F).
#
# Secrets REQUIRED in .env.staging.local (gitignored):
#   REVALIDATE_SECRET  (rotated; openssl rand -base64 32)
#   SENTRY_DSN         (if distinct from dev)
# =============================================================================

PORT=3001

# Build-time public env (inlined into bundle at `pnpm build` time)
NEXT_PUBLIC_API_URL=http://api.staging.news-app.local
NEXT_PUBLIC_SITE_URL=http://staging.news-app.local
NEXT_PUBLIC_CDN_URL=http://127.0.0.1:8082
NEXT_PUBLIC_MERCURE_URL=http://localhost:3000/.well-known/mercure

NEXT_PUBLIC_APP_NAME="Deschide News (Staging)"
NEXT_PUBLIC_ENV=staging

NEXT_PUBLIC_DEFAULT_LOCALE=ro
NEXT_PUBLIC_AVAILABLE_LOCALES=ro,en,ru

NEXT_PUBLIC_AI_CHAT_ENABLED=false
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_REALTIME=true
