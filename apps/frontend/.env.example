NODE_ENV=development
PORT=3005

# API Backend
# Option 1: Direct access to Symfony CLI server
NEXT_PUBLIC_API_URL=http://127.0.0.1:8081
# Option 2: Via Nginx proxy (when configured)
# NEXT_PUBLIC_API_URL=http://api.deschide.local

# Mercure Hub (Real-time notifications)
NEXT_PUBLIC_MERCURE_URL=http://localhost:3000/.well-known/mercure

# App Configuration
NEXT_PUBLIC_APP_NAME="Deschide News"
NEXT_PUBLIC_DEFAULT_LOCALE=ro
NEXT_PUBLIC_AVAILABLE_LOCALES=ro,en,ru

# Site URL (used for canonical URLs, sitemaps, OG tags)
NEXT_PUBLIC_SITE_URL=https://deschide.md

# Feature Flags (for development)
NEXT_PUBLIC_AI_CHAT_ENABLED=false
NEXT_PUBLIC_ENABLE_SEARCH=false
NEXT_PUBLIC_ENABLE_REALTIME=false

# Sentry error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
