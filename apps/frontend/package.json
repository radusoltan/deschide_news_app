{
  "name": "deschide_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "pnpm generate:slugs && next build",
    "build:analyze": "ANALYZE=true next build",
    "build:no-generate": "next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "generate:slugs": "tsx scripts/generate-reserved-slugs.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:archive": "playwright test __tests__/e2e/archive.spec.ts __tests__/e2e/admin-archive.spec.ts",
    "test:integration": "playwright test __tests__/integration",
    "test:smoke": "playwright test __tests__/smoke --project=chromium --reporter=list",
    "test:smoke:all": "playwright test __tests__/smoke --reporter=list",
    "test:performance": "playwright test __tests__/performance --project=chromium --reporter=list",
    "test:performance:cwv": "playwright test __tests__/performance/core-web-vitals.spec.ts --project=chromium",
    "test:performance:load": "playwright test __tests__/performance/page-load-time.spec.ts --project=chromium",
    "test:performance:resources": "playwright test __tests__/performance/resource-loading.spec.ts --project=chromium",
    "test:all": "npm run test && npm run test:e2e",
    "diag:console": "playwright test __tests__/diagnostics/console-capture.diag.ts --headed --project=chromium",
    "diag:network": "playwright test __tests__/diagnostics/network-capture.diag.ts --headed --project=chromium",
    "diag:full": "playwright test __tests__/diagnostics/full-diagnostic.diag.ts --headed --project=chromium",
    "diag:api": "playwright test __tests__/diagnostics/api-health-check.diag.ts --project=chromium",
    "diag:all": "playwright test __tests__/diagnostics --project=chromium",
    "postinstall": "node scripts/copy-tinymce.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.45.0",
    "@tanstack/react-query": "^5.90.12",
    "@tinymce/tinymce-react": "^6.3.0",
    "@tiptap/extension-image": "^3.11.1",
    "@tiptap/extension-link": "^3.11.1",
    "@tiptap/extension-placeholder": "^3.11.1",
    "@tiptap/react": "^3.11.1",
    "@tiptap/starter-kit": "^3.11.1",
    "clsx": "^2.1.1",
    "cropperjs": "^2.1.0",
    "dompurify": "3.3.3",
    "flowbite": "^3.1.2",
    "flowbite-react": "^0.12.10",
    "isomorphic-dompurify": "^2.36.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.552.0",
    "moment": "^2.30.1",
    "next": "16.2.3",
    "next-i18n-router": "^5.5.5",
    "react": "19.2.0",
    "react-cropper": "^2.3.3",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-intl": "^7.1.14",
    "recharts": "^3.5.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tinymce": "^8.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.10",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": ">=3.3.3"
    }
  }
}
