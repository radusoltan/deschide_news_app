+
+        $result = $image->setHeight($height);
+
+        $this->assertSame($image, $result);
+        $this->assertEquals($height, $image->getHeight());
+    }
+
+    // Translatable Fields Tests
+
+    public function testSetAndGetAlt(): void
+    {
