# =============================================================================
# STAGING ENVIRONMENT — non-secret defaults (COMMITTED)
# =============================================================================
#
# Loaded automatically by Symfony Dotenv when APP_ENV=staging.
# Complements: .env.staging.local (secrets, gitignored) — see ADR-023 D7.
#
# Secrets REQUIRED in .env.staging.local (not committed):
#   APP_SECRET                  (rotated; openssl rand -hex 32)
#   DATABASE_URL                (with deschide_user password)
#   ELASTICSEARCH_PASSWORD      (from dev .env.local or rotated)
#   ELASTICSEARCH_API_KEY       (if using API key auth)
#   JWT_PASSPHRASE              (rotated; matches key generated in Phase A)
#   MERCURE_JWT_SECRET          (shared hub; same value as dev hub unless hub rotated)
#
# Do NOT add secrets here. This file is committed to the repo.
# =============================================================================

APP_ENV=staging
APP_DEBUG=0

###> symfony/framework-bundle ###
# APP_SECRET is defined in .env.staging.local (rotated per ADR-023 D7)
TRUSTED_HOSTS='^(api\.staging\.news-app\.local|localhost)$'
TRUSTED_PROXIES=127.0.0.1,127.0.0.0/8
DEFAULT_URI=http://api.staging.news-app.local
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL is defined in .env.staging.local
# (pgbouncer on :6432 → deschide_staging, registered in Phase B)
###< doctrine/doctrine-bundle ###

###> symfony/redis-messenger ###
REDIS_URL=redis://localhost:6379/2
###< symfony/redis-messenger ###

###> symfony/messenger ###
# doctrine transport — staging has no RabbitMQ (per ADR-023 D7)
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(staging\.news-app\.local|api\.staging\.news-app\.local|localhost:3001)$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/staging/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/staging/public.pem
# JWT_PASSPHRASE is defined in .env.staging.local (rotated; matches staging keypair)
###< lexik/jwt-authentication-bundle ###

###> elasticsearch ###
ELASTICSEARCH_HOST=https://localhost:9200
ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD is defined in .env.staging.local
ELASTICSEARCH_VERIFY_SSL=0
ELASTICSEARCH_INDEX_PREFIX=staging_deschide
###< elasticsearch ###

###> symfony/mercure-bundle ###
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# MERCURE_JWT_SECRET is defined in .env.staging.local
###< symfony/mercure-bundle ###

###> symfony/mailer ###
# null transport in staging — prevents accidental mail delivery during SV scenarios
MAILER_DSN=null://null
###< symfony/mailer ###

###> app URLs ###
APP_URL=http://api.staging.news-app.local
FRONTEND_URL=http://staging.news-app.local
###< app URLs ###
