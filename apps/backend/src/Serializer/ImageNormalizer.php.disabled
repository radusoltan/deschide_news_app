<?php

declare(strict_types=1);

namespace App\Serializer;

use App\Entity\Image;
use Symfony\Component\Serializer\Normalizer\NormalizerInterface;
use Symfony\Component\Serializer\Normalizer\NormalizerAwareInterface;
use Symfony\Component\Serializer\Normalizer\NormalizerAwareTrait;
use Vich\UploaderBundle\Storage\StorageInterface;

final class ImageNormalizer implements NormalizerInterface, NormalizerAwareInterface
{
    use NormalizerAwareTrait;

    private const ALREADY_CALLED = 'IMAGE_NORMALIZER_ALREADY_CALLED';

    public function __construct(private StorageInterface $storage)
    {
    }

    public function normalize($object, ?string $format = null, array $context = []): array|string|int|float|bool|\ArrayObject|null
    {
        /** @var Image $object */
        $context[self::ALREADY_CALLED] = true;

        $data = $this->normalizer->normalize($object, $format, $context);

        // Add contentUrl using Vich storage
        if (is_array($data) && $object->getFilename()) {
            $data['contentUrl'] = $this->storage->resolveUri($object, 'file');
        }

        return $data;
    }

    public function supportsNormalization(mixed $data, ?string $format = null, array $context = []): bool
    {
        // Skip if already called to avoid infinite loop
        if (isset($context[self::ALREADY_CALLED])) {
            return false;
        }

        // Only normalize for read operations (GET)
        // Don't normalize during write operations (POST/PUT) to avoid conflicts
        $isWriteOperation = isset($context['operation_type']) && $context['operation_type'] === 'write';
        if ($isWriteOperation) {
            return false;
        }

        return $data instanceof Image;
    }

    public function getSupportedTypes(?string $format): array
    {
        return [
            Image::class => true,
        ];
    }
}
