# =============================================================================
# Deschide News — Mercure Hub Service
# =============================================================================
# Runs the Mercure real-time push hub on port 3000.
#
# Install:
#   sudo cp deschide-mercure.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deschide-mercure.service
#
# Check status:
#   systemctl status deschide-mercure
#   journalctl -u deschide-mercure -f
# =============================================================================

[Unit]
Description=Deschide News Mercure Hub
Documentation=https://mercure.rocks/docs
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data

ExecStart=/usr/local/bin/mercure run --config /etc/mercure/Caddyfile --adapter caddyfile
ExecReload=/bin/kill -USR1 $MAINPID

# Restart policy
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Environment (override via /etc/default/deschide-mercure or drop-in)
Environment=MERCURE_PUBLISHER_JWT_KEY=f81aa10cc4d2972c4e44bbe0fe114e9ca0da126468dbf9568a012bcd5bab74cd
Environment=MERCURE_SUBSCRIBER_JWT_KEY=f81aa10cc4d2972c4e44bbe0fe114e9ca0da126468dbf9568a012bcd5bab74cd

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deschide-mercure

# Resource limits
LimitNOFILE=65536
MemoryMax=256M

[Install]
WantedBy=multi-user.target
