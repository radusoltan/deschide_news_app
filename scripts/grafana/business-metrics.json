{
  "uid": "deschide-business-metrics",
  "title": "Deschide News — Business Metrics",
  "description": "Business-level metrics: article publishing, page views, active users, translations, and image uploads.",
  "tags": ["deschide", "business", "content"],
  "timezone": "Europe/Chisinau",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Articles Published Per Day",
      "description": "Number of articles published each day, tracked by the Deschide News backend.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#1d4ed8" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "lineWidth": 1,
            "axisCenteredZero": false,
            "axisLabel": "articles"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "xTickLabelRotation": -45,
        "showValue": "auto",
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(deschide_news_articles_published_total[1d])",
          "legendFormat": "Published",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "interval": "1d"
        }
      ]
    },
    {
      "id": 2,
      "title": "Page Views",
      "description": "Total page views tracked by the application, derived from the pageviews_total counter.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#047857", "mode": "fixed" },
          "custom": {
            "axisLabel": "views",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "gradientMode": "scheme",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(deschide_news_pageviews_total[1h])",
          "legendFormat": "Page Views / hour",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "rate(deschide_news_pageviews_total[5m]) * 60",
          "legendFormat": "Views / min (rate)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Users",
      "description": "Currently active sessions and unique visitors today.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deschide_news_active_sessions_current",
          "legendFormat": "Active Sessions",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "deschide_news_unique_visitors_total",
          "legendFormat": "Unique Visitors Today",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Translation Coverage (per Locale)",
      "description": "Percentage of articles that have translations available for each supported locale (ro, en, ru).",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "text": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deschide_news_translation_coverage_ratio{locale=\"ro\"}",
          "legendFormat": "Romanian (ro)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "deschide_news_translation_coverage_ratio{locale=\"en\"}",
          "legendFormat": "English (en)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "C",
          "expr": "deschide_news_translation_coverage_ratio{locale=\"ru\"}",
          "legendFormat": "Russian (ru)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "title": "Image Upload Count",
      "description": "Cumulative image uploads over time and current total in the system.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "images",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "scheme",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(deschide_news_image_uploads_total[1d])",
          "legendFormat": "Uploads / day",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "interval": "1d"
        },
        {
          "refId": "B",
          "expr": "deschide_news_image_uploads_total",
          "legendFormat": "Total Uploads (cumulative)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Top Viewed Articles",
      "description": "Top 10 articles by total view count.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "article_id" },
            "properties": [
              { "id": "displayName", "value": "Article ID" },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Total Views" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "transparent", "value": null },
                  { "color": "blue", "value": 100 },
                  { "color": "green", "value": 500 },
                  { "color": "orange", "value": 1000 }
                ]
              }}
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Total Views" }],
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, deschide_news_article_views_total)",
          "legendFormat": "Article {{article_id}}",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "title": "Content Overview",
      "description": "Summary statistics: total articles, categories, authors, and images in the system.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total Articles" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#1d4ed8", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Total Images" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#047857", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Total Authors" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#7c3aed", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Total Categories" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#b45309", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deschide_news_articles_published_total",
          "legendFormat": "Total Articles",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "deschide_news_image_uploads_total",
          "legendFormat": "Total Images",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "C",
          "expr": "deschide_news_authors_total",
          "legendFormat": "Total Authors",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "D",
          "expr": "deschide_news_categories_total",
          "legendFormat": "Total Categories",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ]
}
